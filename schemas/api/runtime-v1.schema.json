{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/api/runtime-v1.schema.json",
  "title": "vLLM-Apple runtime snapshot v1",
  "type": "object",
  "required": [
    "api_version",
    "schema_version",
    "runtime_version",
    "minimum_client_version",
    "state",
    "control_ready",
    "inference_ready",
    "profile",
    "scheduler",
    "events",
    "semantic_cache",
    "elastic_memory",
    "memory_telemetry",
    "memory_budget",
    "memory_admission",
    "token_estimation",
    "context_reevaluation",
    "kv_calibration",
    "native_v2_tuning",
    "execution_plan",
    "last_error",
    "failure"
  ],
  "properties": {
    "api_version": { "const": "v1" },
    "schema_version": { "const": 1 },
    "runtime_version": { "type": "string", "minLength": 1 },
    "minimum_client_version": { "type": "string", "minLength": 1 },
    "state": {
      "enum": [
        "stopped",
        "starting",
        "profiling",
        "loading_model",
        "ready",
        "degraded",
        "failed",
        "stopping"
      ]
    },
    "control_ready": { "type": "boolean" },
    "inference_ready": { "type": "boolean" },
    "last_error": { "type": ["string", "null"] },
    "failure": {
      "type": ["object", "null"],
      "required": ["schema_version", "code", "message_key", "recoverability", "detail_fingerprint"],
      "properties": {
        "schema_version": {"const": 1},
        "code": {"enum": ["backend_startup_failed", "backend_exited", "backend_readiness_timeout", "backend_incompatible", "memory_capacity_exceeded", "execution_plan_rejected", "internal_error"]},
        "message_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "recoverability": {"enum": ["retryable", "user_action_required", "fatal"]},
        "detail_fingerprint": {"type": "string", "minLength": 24, "maxLength": 24}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "profile_version",
        "runtime_version",
        "created_at",
        "hardware",
        "context",
        "capabilities",
        "metadata"
      ],
      "properties": {
        "profile_version": { "type": "integer", "minimum": 1 },
        "runtime_version": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "hardware": { "type": "object" },
        "context": { "type": ["object", "null"] },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "scheduler": {
      "type": "object",
      "required": [
        "capacity_bytes",
        "reserved_bytes",
        "available_bytes",
        "active_reservations"
      ],
      "properties": {
        "capacity_bytes": { "type": "integer", "minimum": 0 },
        "reserved_bytes": { "type": "integer", "minimum": 0 },
        "available_bytes": { "type": "integer", "minimum": 0 },
        "active_reservations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "required": [
        "capacity",
        "retained_events",
        "latest_sequence",
        "active_subscribers",
        "max_subscribers"
      ],
      "properties": {
        "capacity": { "type": "integer", "minimum": 1 },
        "retained_events": { "type": "integer", "minimum": 0 },
        "latest_sequence": { "type": "integer", "minimum": 0 },
        "active_subscribers": { "type": "integer", "minimum": 0 },
        "max_subscribers": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "semantic_cache": {
      "type": "object",
      "required": [
        "enabled",
        "capacity_entries",
        "capacity_bytes",
        "entry_count",
        "resident_bytes",
        "evictions",
        "captures",
        "hits",
        "misses",
        "restore_failures",
        "release_failures",
        "pending_releases",
        "dropped_release_handles"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "capacity_entries": { "type": "integer", "minimum": 0 },
        "capacity_bytes": { "type": "integer", "minimum": 0 },
        "entry_count": { "type": "integer", "minimum": 0 },
        "resident_bytes": { "type": "integer", "minimum": 0 },
        "evictions": { "type": "integer", "minimum": 0 },
        "captures": { "type": "integer", "minimum": 0 },
        "hits": { "type": "integer", "minimum": 0 },
        "misses": { "type": "integer", "minimum": 0 },
        "restore_failures": { "type": "integer", "minimum": 0 },
        "release_failures": { "type": "integer", "minimum": 0 },
        "pending_releases": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "dropped_release_handles": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "elastic_memory": {
      "type": "object",
      "required": [
        "enabled",
        "current_pressure",
        "pending_pressure",
        "normal_capacity_entries",
        "normal_capacity_bytes",
        "current_capacity_entries",
        "current_capacity_bytes",
        "adjustments",
        "deferred_adjustments",
        "last_evicted_entries"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "current_pressure": { "enum": ["normal", "warning", "critical", "unknown"] },
        "pending_pressure": { "type": ["string", "null"], "enum": ["normal", "warning", "critical", null] },
        "normal_capacity_entries": { "type": "integer", "minimum": 0 },
        "normal_capacity_bytes": { "type": "integer", "minimum": 0 },
        "current_capacity_entries": { "type": "integer", "minimum": 0 },
        "current_capacity_bytes": { "type": "integer", "minimum": 0 },
        "adjustments": { "type": "integer", "minimum": 0 },
        "deferred_adjustments": { "type": "integer", "minimum": 0 },
        "last_evicted_entries": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "memory_telemetry": {
      "type": "object",
      "required": [
        "unified_total_bytes", "unified_available_bytes",
        "control_resident_bytes", "control_resident_peak_bytes",
        "backend_resident_bytes", "backend_resident_peak_bytes",
        "allocator_current_bytes", "allocator_peak_bytes",
        "allocator_resident_peak_delta_bytes", "kv_used_bytes",
        "kv_capacity_bytes", "kv_usage_ratio", "iogpu_bytes",
        "iogpu_peak_bytes", "pressure", "pressure_notifications",
        "os_source", "allocator_source",
        "kv_source", "iogpu_source"
      ],
      "properties": {
        "unified_total_bytes": { "type": "integer", "minimum": 1 },
        "unified_available_bytes": { "type": "integer", "minimum": 0 },
        "control_resident_bytes": { "type": "integer", "minimum": 0 },
        "control_resident_peak_bytes": { "type": "integer", "minimum": 0 },
        "backend_resident_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "backend_resident_peak_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "allocator_current_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "allocator_peak_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "allocator_resident_peak_delta_bytes": { "type": ["integer", "null"] },
        "kv_used_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "kv_capacity_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "kv_usage_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "iogpu_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "iogpu_peak_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "pressure": { "enum": ["normal", "warning", "critical", "unknown"] },
        "pressure_notifications": { "type": "integer", "minimum": 0 },
        "os_source": { "type": "string", "minLength": 1 },
        "allocator_source": { "type": ["string", "null"] },
        "kv_source": { "type": ["string", "null"] },
        "iogpu_source": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "memory_budget": {
      "type": "object",
      "required": ["capacity_bytes", "known_component_bytes", "known_remaining_bytes", "overcommitted_bytes", "unknown_components", "overlap_envelope_bytes", "components"],
      "properties": {
        "capacity_bytes": { "type": "integer", "minimum": 1 },
        "known_component_bytes": { "type": "integer", "minimum": 0 },
        "known_remaining_bytes": { "type": "integer", "minimum": 0 },
        "overcommitted_bytes": { "type": "integer", "minimum": 0 },
        "unknown_components": { "type": "array", "maxItems": 10, "items": { "enum": ["weights", "kv", "recurrent", "prefix", "window", "experts", "ngram", "mtp", "scratch", "coreml"] } },
        "overlap_envelope_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "components": {
          "type": "object",
          "required": ["weights", "kv", "recurrent", "prefix", "window", "experts", "ngram", "mtp", "scratch", "metal_heap", "coreml"],
          "properties": {
            "weights": { "type": "object", "required": ["current_bytes", "peak_bytes", "source", "accounting"], "properties": { "current_bytes": { "type": ["integer", "null"], "minimum": 0 }, "peak_bytes": { "type": ["integer", "null"], "minimum": 0 }, "source": { "type": ["string", "null"] }, "accounting": { "const": "additive" } }, "additionalProperties": false },
            "kv": { "type": "object", "required": ["current_bytes", "peak_bytes", "source", "accounting"], "properties": { "current_bytes": { "type": ["integer", "null"], "minimum": 0 }, "peak_bytes": { "type": ["integer", "null"], "minimum": 0 }, "source": { "type": ["string", "null"] }, "accounting": { "const": "additive" } }, "additionalProperties": false },
            "recurrent": { "type": "object", "required": ["current_bytes", "peak_bytes", "source", "accounting"], "properties": { "current_bytes": { "type": ["integer", "null"], "minimum": 0 }, "peak_bytes": { "type": ["integer", "null"], "minimum": 0 }, "source": { "type": ["string", "null"] }, "accounting": { "const": "additive" } }, "additionalProperties": false },
            "prefix": { "type": "object", "required": ["current_bytes", "peak_bytes", "source", "accounting"], "properties": { "current_bytes": { "type": ["integer", "null"], "minimum": 0 }, "peak_bytes": { "type": ["integer", "null"], "minimum": 0 }, "source": { "type": ["string", "null"] }, "accounting": { "const": "additive" } }, "additionalProperties": false },
            "window": { "type": "object", "required": ["current_bytes", "peak_bytes", "source", "accounting"], "properties": { "current_bytes": { "type": ["integer", "null"], "minimum": 0 }, "peak_bytes": { "type": ["integer", "null"], "minimum": 0 }, "source": { "type": ["string", "null"] }, "accounting": { "const": "additive" } }, "additionalProperties": false },
            "experts": { "type": "object", "required": ["current_bytes", "peak_bytes", "source", "accounting"], "properties": { "current_bytes": { "type": ["integer", "null"], "minimum": 0 }, "peak_bytes": { "type": ["integer", "null"], "minimum": 0 }, "source": { "type": ["string", "null"] }, "accounting": { "const": "additive" } }, "additionalProperties": false },
            "ngram": { "type": "object", "required": ["current_bytes", "peak_bytes", "source", "accounting"], "properties": { "current_bytes": { "type": ["integer", "null"], "minimum": 0 }, "peak_bytes": { "type": ["integer", "null"], "minimum": 0 }, "source": { "type": ["string", "null"] }, "accounting": { "const": "additive" } }, "additionalProperties": false },
            "mtp": { "type": "object", "required": ["current_bytes", "peak_bytes", "source", "accounting"], "properties": { "current_bytes": { "type": ["integer", "null"], "minimum": 0 }, "peak_bytes": { "type": ["integer", "null"], "minimum": 0 }, "source": { "type": ["string", "null"] }, "accounting": { "const": "additive" } }, "additionalProperties": false },
            "scratch": { "type": "object", "required": ["current_bytes", "peak_bytes", "source", "accounting"], "properties": { "current_bytes": { "type": ["integer", "null"], "minimum": 0 }, "peak_bytes": { "type": ["integer", "null"], "minimum": 0 }, "source": { "type": ["string", "null"] }, "accounting": { "const": "additive" } }, "additionalProperties": false },
            "metal_heap": { "type": "object", "required": ["current_bytes", "peak_bytes", "source", "accounting"], "properties": { "current_bytes": { "type": ["integer", "null"], "minimum": 0 }, "peak_bytes": { "type": ["integer", "null"], "minimum": 0 }, "source": { "type": ["string", "null"] }, "accounting": { "const": "overlap_envelope" } }, "additionalProperties": false },
            "coreml": { "type": "object", "required": ["current_bytes", "peak_bytes", "source", "accounting"], "properties": { "current_bytes": { "type": ["integer", "null"], "minimum": 0 }, "peak_bytes": { "type": ["integer", "null"], "minimum": 0 }, "source": { "type": ["string", "null"] }, "accounting": { "const": "additive" } }, "additionalProperties": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "memory_admission": {
      "type": "object",
      "required": [
        "effective_pressure", "admitted", "rejected", "last_rejection_reason",
        "recovery_stage", "recovery_max_batch_size",
        "recovery_max_context_tokens", "recovery_memory_fraction"
      ],
      "properties": {
        "effective_pressure": { "enum": ["normal", "warning", "critical", "unknown"] },
        "admitted": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "last_rejection_reason": {
          "type": ["string", "null"],
          "enum": [
            "critical_memory_pressure", "warning_memory_pressure_background",
            "insufficient_unified_memory", "memory_budget_overcommitted",
            "memory_budget_exceeded", "backend_context_capacity_exceeded",
            "recovery_batch_limited",
            "recovery_context_limited", "recovery_memory_limited", null
          ]
        },
        "recovery_stage": { "type": ["integer", "null"], "minimum": 0, "maximum": 2 },
        "recovery_max_batch_size": { "type": ["integer", "null"], "minimum": 1 },
        "recovery_max_context_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "recovery_memory_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "token_estimation": {
      "type": "object",
      "required": ["source", "measured", "failures", "fallbacks", "last_prompt_tokens", "cache_capacity", "cache_entries", "cache_hits", "cache_misses", "cache_evictions", "cache_expirations", "single_flight_capacity", "single_flight_active", "single_flight_leaders", "single_flight_followers", "single_flight_bypasses", "single_flight_timeouts"],
      "properties": {
        "source": { "enum": ["backend_tokenizer", "fallback"] },
        "measured": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "fallbacks": { "type": "integer", "minimum": 0 },
        "last_prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_capacity": { "type": "integer", "minimum": 0 },
        "cache_entries": { "type": "integer", "minimum": 0 },
        "cache_hits": { "type": "integer", "minimum": 0 },
        "cache_misses": { "type": "integer", "minimum": 0 },
        "cache_evictions": { "type": "integer", "minimum": 0 },
        "cache_expirations": { "type": "integer", "minimum": 0 },
        "single_flight_capacity": { "type": "integer", "minimum": 0 },
        "single_flight_active": { "type": "integer", "minimum": 0 },
        "single_flight_leaders": { "type": "integer", "minimum": 0 },
        "single_flight_followers": { "type": "integer", "minimum": 0 },
        "single_flight_bypasses": { "type": "integer", "minimum": 0 },
        "single_flight_timeouts": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "context_reevaluation": {
      "type": "object",
      "required": ["enabled", "status", "configured_context_tokens", "effective_context_tokens", "capacity_context_tokens", "kv_capacity_bytes", "kv_bytes_per_token", "weights_bytes", "source", "reevaluations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "status": { "enum": ["disabled", "pending", "sufficient", "reduced"] },
        "configured_context_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "effective_context_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "capacity_context_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "kv_capacity_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "kv_bytes_per_token": { "type": ["integer", "null"], "minimum": 1 },
        "weights_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "type": ["string", "null"] },
        "reevaluations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "kv_calibration": {
      "type": "object",
      "required": ["enabled", "status", "backend", "evaluation_id", "calibrated_bytes_per_token", "maximum_observed_context", "sample_count", "safety_margin_ratio"],
      "properties": {
        "enabled": { "type": "boolean" },
        "status": { "enum": ["not_configured", "disabled", "not_found", "invalid", "applied"] },
        "backend": { "type": ["string", "null"] },
        "evaluation_id": { "type": ["string", "null"] },
        "calibrated_bytes_per_token": { "type": ["integer", "null"], "minimum": 1 },
        "maximum_observed_context": { "type": ["integer", "null"], "minimum": 1 },
        "sample_count": { "type": ["integer", "null"], "minimum": 1 },
        "safety_margin_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "native_v2_tuning": {
      "type": "object",
      "required": ["enabled", "status", "run_id", "profile_id", "error_code", "quarantined_profiles", "latest_quarantined_profile_id"],
      "properties": {
        "enabled": { "type": "boolean" },
        "status": { "enum": ["disabled", "idle", "waiting_for_idle", "running", "applied", "failed"] },
        "run_id": { "type": "integer", "minimum": 0 },
        "profile_id": { "type": ["string", "null"], "minLength": 24, "maxLength": 24 },
        "error_code": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "quarantined_profiles": { "type": "integer", "minimum": 0, "maximum": 64 },
        "latest_quarantined_profile_id": { "type": ["string", "null"], "minLength": 24, "maxLength": 24 }
      },
      "additionalProperties": false
    },
    "execution_plan": {
      "type": "object",
      "required": ["enabled", "active_plan_id", "pending_plan_id", "context_tokens", "prefill_batch_size", "decode_batch_size", "state_precision"],
      "properties": {
        "enabled": { "type": "boolean" },
        "active_plan_id": { "type": ["string", "null"] },
        "pending_plan_id": { "type": ["string", "null"] },
        "context_tokens": { "type": "integer", "minimum": 0 },
        "prefill_batch_size": { "type": "integer", "minimum": 0 },
        "decode_batch_size": { "type": "integer", "minimum": 0 },
        "state_precision": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
