{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/events/runtime-event-v1.schema.json",
  "title": "vLLM-Apple runtime event v1",
  "type": "object",
  "required": ["schema_version", "event_id", "type", "timestamp", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}

