{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/optimizer/gguf-export-invocation-v1.schema.json",
  "title": "vLLM-Apple GGUF export invocation v1",
  "type": "object",
  "required": ["schema_version", "adapter_id", "adapter_api_version", "implementation_version", "converter_version", "source_path", "output_path", "source_fingerprint", "output_type", "estimated_output_bytes", "maximum_output_bytes", "command"],
  "properties": {
    "schema_version": { "const": 1 },
    "adapter_id": { "const": "builtin.llama-cpp-gguf" },
    "adapter_api_version": { "const": 1 },
    "implementation_version": { "const": "1.0.0" },
    "converter_version": { "type": "string", "minLength": 5, "maxLength": 7 },
    "source_path": { "type": "string", "minLength": 1 },
    "output_path": { "type": "string", "minLength": 1 },
    "source_fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
    "output_type": { "enum": ["f16", "bf16", "q8_0"] },
    "estimated_output_bytes": { "type": "integer", "minimum": 1 },
    "maximum_output_bytes": { "type": "integer", "minimum": 1 },
    "command": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
