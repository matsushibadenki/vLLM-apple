{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/optimizer/real-model-correctness-regression-v1.schema.json",
  "title": "vLLM-Apple real-model correctness regression v1",
  "type": "object",
  "required": ["schema_version", "suite_version", "baseline_model_hash", "candidate_model_hash", "dataset_fingerprint", "sample_count", "languages", "domains", "required_runs", "runs", "maximum_latency_regression", "maximum_rss_regression", "latency_regression", "rss_regression", "approved", "report_id"],
  "properties": {
    "schema_version": { "const": 1 },
    "suite_version": { "const": 1 },
    "baseline_model_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "candidate_model_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "dataset_fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
    "sample_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "languages": { "type": "array", "minItems": 3, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
    "domains": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1 } },
    "required_runs": { "type": "integer", "minimum": 2, "maximum": 16 },
    "runs": {
      "type": "array", "minItems": 2, "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["run_index", "candidate_model_hash", "elapsed_milliseconds", "peak_rss_bytes", "minimum_token_agreement", "maximum_expectation_regression", "deterministic_with_prior_runs", "passed"],
        "properties": {
          "run_index": { "type": "integer", "minimum": 1, "maximum": 16 },
          "candidate_model_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
          "elapsed_milliseconds": { "type": "integer", "minimum": 0 },
          "peak_rss_bytes": { "type": "integer", "minimum": 1 },
          "minimum_token_agreement": { "type": "number", "minimum": 0, "maximum": 1 },
          "maximum_expectation_regression": { "type": "number", "minimum": -1, "maximum": 1 },
          "deterministic_with_prior_runs": { "type": "boolean" },
          "passed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "maximum_latency_regression": { "type": "number", "minimum": 0 },
    "maximum_rss_regression": { "type": "number", "minimum": 0 },
    "latency_regression": { "type": "number", "minimum": -1 },
    "rss_regression": { "type": "number", "minimum": -1 },
    "approved": { "type": "boolean" },
    "report_id": { "type": "string", "minLength": 64, "maxLength": 64 }
  },
  "additionalProperties": false
}
