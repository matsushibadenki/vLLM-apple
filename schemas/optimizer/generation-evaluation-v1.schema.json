{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/optimizer/generation-evaluation-v1.schema.json",
  "title": "vLLM-Apple deterministic generation evaluation v1",
  "type": "object",
  "required": ["schema_version", "model_path", "model_hash", "dataset_path", "dataset_fingerprint", "prompt_format", "maximum_prompt_tokens", "maximum_new_tokens", "elapsed_milliseconds", "peak_rss_bytes", "samples"],
  "properties": {
    "schema_version": { "const": 1 },
    "model_path": { "type": "string", "minLength": 1 },
    "model_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "dataset_path": { "type": "string", "minLength": 1 },
    "dataset_fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
    "prompt_format": { "type": "string", "enum": ["raw", "chat_template"] },
    "maximum_prompt_tokens": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "maximum_new_tokens": { "type": "integer", "minimum": 1, "maximum": 256 },
    "elapsed_milliseconds": { "type": "integer", "minimum": 0 },
    "peak_rss_bytes": { "type": "integer", "minimum": 1 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["sample_id", "domain", "language", "prompt_token_count", "token_ids", "output_fingerprint", "expectation_score"],
        "properties": {
          "sample_id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "prompt_token_count": { "type": "integer", "minimum": 1, "maximum": 65536 },
          "token_ids": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "integer", "minimum": 0 } },
          "output_fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
          "expectation_score": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
