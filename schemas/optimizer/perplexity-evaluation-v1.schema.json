{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/optimizer/perplexity-evaluation-v1.schema.json",
  "title": "vLLM-Apple bounded perplexity evaluation v1",
  "type": "object",
  "required": ["schema_version", "model_path", "model_hash", "dataset_path", "dataset_fingerprint", "sample_count", "token_count", "mean_negative_log_likelihood", "perplexity", "elapsed_milliseconds", "peak_rss_bytes", "slices"],
  "properties": {
    "schema_version": { "const": 1 },
    "model_path": { "type": "string", "minLength": 1 },
    "model_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "dataset_path": { "type": "string", "minLength": 1 },
    "dataset_fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
    "sample_count": { "type": "integer", "minimum": 1 },
    "token_count": { "type": "integer", "minimum": 1 },
    "mean_negative_log_likelihood": { "type": "number", "minimum": 0 },
    "perplexity": { "type": "number", "minimum": 1 },
    "elapsed_milliseconds": { "type": "integer", "minimum": 0 },
    "peak_rss_bytes": { "type": "integer", "minimum": 1 },
    "slices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["domain", "language", "sample_count", "token_count", "mean_negative_log_likelihood", "perplexity"],
        "properties": {
          "domain": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "sample_count": { "type": "integer", "minimum": 1 },
          "token_count": { "type": "integer", "minimum": 1 },
          "mean_negative_log_likelihood": { "type": "number", "minimum": 0 },
          "perplexity": { "type": "number", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
