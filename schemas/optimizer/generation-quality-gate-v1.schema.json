{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/optimizer/generation-quality-gate-v1.schema.json",
  "title": "vLLM-Apple deterministic generation quality gate v1",
  "type": "object",
  "required": ["schema_version", "created_at", "dataset_fingerprint", "baseline_model_hash", "candidate_model_hash", "approved", "samples", "untested_capabilities"],
  "properties": {
    "schema_version": { "const": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "dataset_fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
    "baseline_model_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "candidate_model_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "approved": { "type": "boolean" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["sample_id", "domain", "language", "token_agreement", "minimum_token_agreement", "baseline_expectation_score", "candidate_expectation_score", "expectation_regression", "maximum_expectation_regression", "passed"],
        "properties": {
          "sample_id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "token_agreement": { "type": "number", "minimum": 0, "maximum": 1 },
          "minimum_token_agreement": { "type": "number", "minimum": 0, "maximum": 1 },
          "baseline_expectation_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "candidate_expectation_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "expectation_regression": { "type": "number", "minimum": -1, "maximum": 1 },
          "maximum_expectation_regression": { "type": "number", "minimum": 0, "maximum": 1 },
          "passed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "untested_capabilities": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
