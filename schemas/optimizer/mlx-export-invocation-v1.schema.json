{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/optimizer/mlx-export-invocation-v1.schema.json",
  "title": "vLLM-Apple MLX export invocation v1",
  "type": "object",
  "required": ["schema_version", "adapter_id", "implementation_version", "source_path", "output_path", "source_fingerprint", "target_weight_bits", "group_size", "estimated_output_bytes", "maximum_output_bytes", "command"],
  "properties": {
    "schema_version": { "const": 1 },
    "adapter_id": { "const": "builtin.mlx-lm" },
    "implementation_version": { "type": "string", "minLength": 1 },
    "source_path": { "type": "string", "minLength": 1 },
    "output_path": { "type": "string", "minLength": 1 },
    "source_fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
    "target_weight_bits": { "enum": [4, 8] },
    "group_size": { "enum": [32, 64, 128] },
    "estimated_output_bytes": { "type": "integer", "minimum": 1 },
    "maximum_output_bytes": { "type": "integer", "minimum": 1 },
    "command": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
