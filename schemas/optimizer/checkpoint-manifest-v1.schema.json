{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/optimizer/checkpoint-manifest-v1.schema.json",
  "title": "vLLM-Apple optimizer checkpoint manifest v1",
  "type": "object",
  "required": ["schema_version", "plan_id", "source_path", "source_fingerprint", "output_path", "execution_fingerprint", "maximum_output_bytes", "stage", "attempt", "updated_at", "workspace_path", "output_bytes", "file_count", "output_hash", "elapsed_milliseconds", "peak_child_rss_bytes", "last_error_code"],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "source_path": { "type": "string", "minLength": 1 },
    "source_fingerprint": { "type": "string", "minLength": 16 },
    "output_path": { "type": "string", "minLength": 1 },
    "execution_fingerprint": { "type": "string", "minLength": 64 },
    "maximum_output_bytes": { "type": "integer", "minimum": 1 },
    "stage": { "enum": ["prepared", "converted", "completed", "failed", "cancelled"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "workspace_path": { "type": ["string", "null"] },
    "output_bytes": { "type": "integer", "minimum": 0 },
    "file_count": { "type": "integer", "minimum": 0 },
    "output_hash": { "type": ["string", "null"] },
    "elapsed_milliseconds": { "type": "integer", "minimum": 0 },
    "peak_child_rss_bytes": { "type": "integer", "minimum": 0 },
    "last_error_code": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
