{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/optimizer/candidate-comparison-v1.schema.json",
  "title": "vLLM-Apple optimization candidate comparison v1",
  "type": "object",
  "required": ["schema_version", "created_at", "winner_candidate_id", "ranking_policy", "candidates"],
  "properties": {
    "schema_version": { "const": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "winner_candidate_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ranking_policy": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["rank", "candidate_id", "quality_approved", "task_score", "artifact_bytes", "throughput_tokens_per_second", "peak_rss_bytes", "eligible", "rejection_reasons"],
        "properties": {
          "rank": { "type": ["integer", "null"], "minimum": 1 },
          "candidate_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "quality_approved": { "type": "boolean" },
          "task_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "artifact_bytes": { "type": "integer", "minimum": 1 },
          "throughput_tokens_per_second": { "type": "number", "minimum": 0.000000001 },
          "peak_rss_bytes": { "type": "integer", "minimum": 1 },
          "eligible": { "type": "boolean" },
          "rejection_reasons": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
