{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/runtime/apple-chip-profile-v1.schema.json",
  "title": "AppleChipProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "hardware_fingerprint", "soc", "total_memory_bytes", "backends", "precisions", "platform", "architecture", "os_version", "gpu_core_count", "capability_issues", "measured_memory_bandwidth_bytes_per_second", "metal_launch_latency_nanoseconds"],
  "properties": {
    "profile_version": { "const": 1 },
    "hardware_fingerprint": { "type": "string", "minLength": 24, "maxLength": 24 },
    "soc": { "type": "string", "minLength": 1 },
    "total_memory_bytes": { "type": "integer", "minimum": 1 },
    "backends": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["vllm_metal", "native_mlx", "native_metal", "coreml_draft", "cpu"] }
    },
    "precisions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "platform": { "type": "string", "minLength": 1 },
    "architecture": { "type": "string", "minLength": 1 },
    "os_version": { "type": "string", "minLength": 1 },
    "gpu_core_count": { "type": ["integer", "null"], "minimum": 1 },
    "capability_issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "measured_memory_bandwidth_bytes_per_second": { "type": ["integer", "null"], "minimum": 1 },
    "metal_launch_latency_nanoseconds": { "type": ["integer", "null"], "minimum": 1 }
  }
}
