{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/runtime/kernel-shape-profile-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "model_id", "architecture", "layers", "kv_dtype_bytes", "shapes"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "profile_id": { "type": "string", "minLength": 24, "maxLength": 24 },
    "model_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "architecture": { "type": "string", "minLength": 1, "maxLength": 128 },
    "layers": { "type": "integer", "minimum": 1 },
    "kv_dtype_bytes": { "type": "integer", "enum": [1, 2, 4] },
    "shapes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context_tokens", "batch_size", "query_heads", "kv_heads", "head_dimension", "block_tokens", "blocks_per_sequence", "kv_working_set_bytes"],
        "properties": {
          "context_tokens": { "type": "integer", "minimum": 1 },
          "batch_size": { "type": "integer", "minimum": 1 },
          "query_heads": { "type": "integer", "minimum": 1 },
          "kv_heads": { "type": "integer", "minimum": 1 },
          "head_dimension": { "type": "integer", "minimum": 1 },
          "block_tokens": { "type": "integer", "minimum": 1, "maximum": 1024 },
          "blocks_per_sequence": { "type": "integer", "minimum": 1 },
          "kv_working_set_bytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
