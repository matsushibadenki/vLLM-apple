{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/runtime/vllm-metal-v2-tuning-profile-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "hardware_fingerprint", "source_fingerprint", "tie_ratio", "decisions"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "profile_id": { "type": "string", "minLength": 24, "maxLength": 24 },
    "hardware_fingerprint": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_fingerprint": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tie_ratio": { "type": "number", "const": 1.02 },
    "decisions": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shape", "winner", "candidates"],
        "properties": {
          "shape": { "type": "object" },
          "winner": { "type": "object" },
          "candidates": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "object" } }
        }
      }
    }
  }
}
