{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/runtime/model-integrity-manifest-v1.schema.json",
  "title": "Model integrity manifest v1",
  "type": "object",
  "required": ["schema_version", "algorithm", "file_count", "total_bytes", "root_sha256", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "algorithm": {"const": "sha256"},
    "file_count": {"type": "integer", "minimum": 1, "maximum": 100000},
    "total_bytes": {"type": "integer", "minimum": 0},
    "root_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "minLength": 64, "maxLength": 64}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
