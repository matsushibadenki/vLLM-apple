{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-apple.local/schemas/runtime/generative-qualification-plan-v1.schema.json",
  "title": "Bounded generative qualification plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate", "width", "height", "frames", "steps", "batch_size", "quantization", "components", "component_artifact_bytes", "component_resident_bytes", "component_totals_verified", "initial_profile", "issues", "artifact_admission", "eligible"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "model", "modality", "tier", "modes", "initial_width", "initial_height", "initial_frames", "initial_steps", "requires_quantization", "required_strategies"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "model": {"type": "string", "minLength": 1, "maxLength": 4096},
        "modality": {"enum": ["image", "video"]},
        "tier": {"enum": ["A", "B", "C"]},
        "modes": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "initial_width": {"type": "integer", "minimum": 1, "maximum": 4096},
        "initial_height": {"type": "integer", "minimum": 1, "maximum": 4096},
        "initial_frames": {"type": "integer", "minimum": 1, "maximum": 257},
        "initial_steps": {"type": "integer", "minimum": 1, "maximum": 200},
        "requires_quantization": {"type": "boolean"},
        "required_strategies": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 64}}
      }
    },
    "width": {"type": "integer", "minimum": 1, "maximum": 4096},
    "height": {"type": "integer", "minimum": 1, "maximum": 4096},
    "frames": {"type": "integer", "minimum": 1, "maximum": 257},
    "steps": {"type": "integer", "minimum": 1, "maximum": 200},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 8},
    "quantization": {"enum": ["none", "int8", "fp8", "int4", "other"]},
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "artifact_bytes", "estimated_resident_bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "role": {"enum": ["denoiser", "text_encoder", "vae", "other"]},
          "artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 17592186044416},
          "estimated_resident_bytes": {"type": "integer", "minimum": 1, "maximum": 17592186044416}
        }
      }
    },
    "component_artifact_bytes": {"type": "integer", "minimum": 1},
    "component_resident_bytes": {"type": "integer", "minimum": 1},
    "component_totals_verified": {"type": "boolean"},
    "initial_profile": {"type": "boolean"},
    "issues": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "artifact_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "model", "artifact_bytes", "estimated_resident_bytes", "memory_hard_ceiling_bytes", "disk_free_bytes", "disk_required_bytes", "fits_memory", "fits_disk", "eligible"],
      "properties": {
        "schema_version": {"const": 1},
        "model": {"type": "string", "minLength": 1, "maxLength": 4096},
        "artifact_bytes": {"type": "integer", "minimum": 1},
        "estimated_resident_bytes": {"type": "integer", "minimum": 1},
        "memory_hard_ceiling_bytes": {"type": "integer", "minimum": 0},
        "disk_free_bytes": {"type": "integer", "minimum": 0},
        "disk_required_bytes": {"type": "integer", "minimum": 1},
        "fits_memory": {"type": "boolean"},
        "fits_disk": {"type": "boolean"},
        "eligible": {"type": "boolean"}
      }
    },
    "eligible": {"type": "boolean"}
  }
}
