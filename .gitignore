__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.cache/
.venv/
.venv-*/
.build/
.swiftpm/
DerivedData/
.DS_Store

# Local self-hosted GitHub Actions installation, credentials, worktrees, and logs.
actions-runner/

# Local qualification evidence. Workflows upload only explicitly selected reports.
qualification-results/
qualification-private/

# Model weights and locally fetched model metadata can be very large.
models/

# Keep published locales available in clean CI checkouts.
# Do not ignore website/ itself: Git cannot re-include its children otherwise.
/website/*
!website/jp/
!website/en/
!website/zh/

# Local design drafts and preview renders are not published site assets.
/website/*/desktop-preview.png
/website/*/mobile-preview.png
/website/*/assets/design-concept.png
/website/*/assets/img/design-concept.png
/website/*/assets/img/desktop-preview.png
/website/*/assets/img/mobile-preview.png
